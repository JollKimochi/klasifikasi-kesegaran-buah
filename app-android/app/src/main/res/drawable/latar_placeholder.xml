<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/latar_gambar"
                android:startColor="@color/latar_gambar_muda" />
        </shape>
    </item>

    <item
        android:bottom="14dp"
        android:left="14dp"
        android:right="14dp"
        android:top="14dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/hijau_lembut"
                android:dashGap="6dp"
                android:dashWidth="5dp" />
        </shape>
    </item>
</layer-list>
